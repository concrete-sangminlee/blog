---
import "@/styles/global.css";
import "@/styles/typography.css";
import katexStylesheet from "katex/dist/katex-swap.min.css?url";
import { SITE, SOCIAL } from "@/data/site.config";
import { href } from "@/utils/paths";
import {
  getDefaultSocialImage,
  SOCIAL_IMAGE_HEIGHT,
  SOCIAL_IMAGE_WIDTH,
} from "@/utils/social-image";

export interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  imageAlt?: string | undefined;
  math?: boolean | undefined;
  ogType?: "website" | "article" | undefined;
  publishedTime?: Date | undefined;
  modifiedTime?: Date | undefined;
  tags?: readonly string[] | undefined;
  readingMinutes?: number | undefined;
  noIndex?: boolean | undefined;
}

const {
  title,
  description,
  image,
  imageAlt,
  math = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags,
  readingMinutes,
  noIndex = false,
} = Astro.props;

const site = Astro.site ?? new URL(import.meta.env.SITE);
const canonicalURL = new URL(Astro.url.pathname, site);
const homeURL = new URL(href("/"), site).toString();
const aboutURL = new URL(href("/about/"), site).toString();
const socialImageURL = new URL(image ?? getDefaultSocialImage(), site);
const IMAGE_TYPES: Record<string, string> = {
  png: "image/png",
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  webp: "image/webp",
  gif: "image/gif",
  avif: "image/avif",
  svg: "image/svg+xml",
};
const socialImageExt = socialImageURL.pathname.split(".").pop()?.toLowerCase() ?? "";
const socialImageType = IMAGE_TYPES[socialImageExt];
// Only the generated cards are known to be 1200×630; an author's own cover
// image (e.g. a 1600 px WebP from the admin) must not claim that size.
const isGeneratedCard = socialImageURL.pathname.startsWith(href("/og/"));
const socialImageAlt = imageAlt ?? `${title} 대표 이미지`;
const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
// Open Graph wants language_TERRITORY ("ko_KR"), not a BCP 47 tag.
const ogLocale = SITE.lang.replace("-", "_");

const author = {
  "@type": "Person",
  "@id": `${aboutURL}#person`,
  name: SITE.author,
  url: aboutURL,
  sameAs: [SOCIAL.github],
};

const website = {
  "@type": "WebSite",
  "@id": `${homeURL}#website`,
  name: SITE.title,
  description: SITE.description,
  url: homeURL,
  inLanguage: SITE.lang,
  author: { "@id": author["@id"] },
};

const graph =
  ogType === "article"
    ? [
        {
          "@type": "BlogPosting",
          "@id": `${canonicalURL}#article`,
          headline: title,
          description,
          url: canonicalURL.toString(),
          mainEntityOfPage: canonicalURL.toString(),
          image: {
            "@type": "ImageObject",
            url: socialImageURL.toString(),
            ...(isGeneratedCard && { width: SOCIAL_IMAGE_WIDTH, height: SOCIAL_IMAGE_HEIGHT }),
          },
          ...(publishedTime && { datePublished: publishedTime.toISOString() }),
          ...((modifiedTime ?? publishedTime) && {
            dateModified: (modifiedTime ?? publishedTime)!.toISOString(),
          }),
          ...(tags && tags.length > 0 && { keywords: [...tags] }),
          ...(readingMinutes && { timeRequired: `PT${readingMinutes}M` }),
          inLanguage: SITE.lang,
          author: { "@id": author["@id"] },
          publisher: { "@id": author["@id"] },
          isPartOf: { "@id": website["@id"] },
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "홈", item: homeURL },
            { "@type": "ListItem", position: 2, name: title, item: canonicalURL.toString() },
          ],
        },
        website,
        author,
      ]
    : [website, author];

// Escape "<" so a title containing "</script>" can't break out of the tag.
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
{noIndex && <meta name="robots" content="noindex, follow" />}

<!-- The site is dark-only, so browser UI should use the dark palette too. -->
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#08080a" />
<!-- Stop iOS from turning numbers in Korean prose into phone links. -->
<meta name="format-detection" content="telephone=no" />

<!-- Intentionally empty: prevents browsers from auto-requesting /favicon.ico. -->
<link rel="icon" href="data:," />

<!-- Canonical URL (omitted on noIndex pages: 404 shouldn't self-canonicalise) -->
{!noIndex && <link rel="canonical" href={canonicalURL} />}

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

{!noIndex && (
  <>
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {isGeneratedCard && (
      <>
        <meta property="og:image:width" content={SOCIAL_IMAGE_WIDTH.toString()} />
        <meta property="og:image:height" content={SOCIAL_IMAGE_HEIGHT.toString()} />
      </>
    )}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </>
)}

{!noIndex && ogType === "article" && (
  <>
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta property="article:author" content={aboutURL} />
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

{!noIndex && <script type="application/ld+json" set:html={jsonLd} />}

<!-- Pretendard font files come from jsDelivr (their @font-face rules are
     bundled in our CSS); open the connection early. -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

<!-- KaTeX styles, self-hosted from the same katex version that rendered
     the HTML at build time; only pages with math request them. -->
{math && <link rel="stylesheet" href={katexStylesheet} />}

<link rel="sitemap" href={href("/sitemap-index.xml")} />
