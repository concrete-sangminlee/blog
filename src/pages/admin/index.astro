---
import "@/styles/global.css";
import { POST_LIMITS } from "@/lib/post-rules";
import { REPO } from "@/data/site.config";
import { href } from "@/utils/paths";

/*
 * Browser admin: write and edit posts straight from GitHub.
 *
 * The token never leaves this page except as an Authorization header to
 * api.github.com, and the Content-Security-Policy below makes that
 * structural: scripts may only come from this origin and network requests
 * may only go to GitHub's API. A post body is previewed inside a sandboxed
 * iframe without script permission, so nothing in a post can read the token.
 */
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self' https://cdn.jsdelivr.net",
  "img-src 'self' data: https:",
  "connect-src https://api.github.com",
  "frame-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
].join("; ");

const newTokenUrl =
  "https://github.com/settings/personal-access-tokens/new" +
  `?name=${encodeURIComponent("Blog admin")}` +
  "&description=" +
  encodeURIComponent(`${REPO.owner}/${REPO.name} 글 작성용`) +
  `&target_name=${REPO.owner}&expires_in=90&contents=write`;
---

<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08080a" />
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <title>블로그 관리</title>
  </head>
  <body class="admin">
    <noscript><p class="admin-noscript">관리 화면은 JavaScript가 필요합니다.</p></noscript>

    <!-- Login -->
    <main id="view-login" class="view login" hidden>
      <h1 class="login-title">블로그 관리</h1>
      <p class="muted">
        GitHub 토큰으로 <code>{REPO.owner}/{REPO.name}</code> 저장소에 글을 바로 커밋합니다.
      </p>
      <form id="login-form" class="login-form" novalidate>
        <label class="field">
          <span class="field-label">GitHub 토큰</span>
          <input
            id="token-input"
            type="password"
            autocomplete="off"
            spellcheck="false"
            placeholder="github_pat_…"
            required
          />
        </label>
        <label class="check">
          <input id="remember-input" type="checkbox" />
          <span>이 브라우저에 기억하기 <small class="muted">(끄면 탭을 닫을 때 지워집니다)</small></span>
        </label>
        <button type="submit" class="btn btn-primary">시작하기</button>
        <p id="login-status" class="status" role="status" aria-live="polite"></p>
      </form>
      <details class="help">
        <summary>토큰 만드는 법</summary>
        <ol>
          <li>
            <a href={newTokenUrl} target="_blank" rel="noopener noreferrer">Fine-grained 토큰 만들기</a>
            를 엽니다.
          </li>
          <li><strong>Repository access</strong>: Only select repositories → <code>{REPO.name}</code></li>
          <li><strong>Permissions</strong>: Contents → <em>Read and write</em> (Metadata는 자동)</li>
          <li>만료 기한은 짧게(예: 90일) 두는 편이 안전합니다.</li>
        </ol>
        <p class="muted">
          classic 토큰의 <code>repo</code> 권한은 모든 저장소를 열어 주므로 권장하지 않습니다.
        </p>
      </details>
    </main>

    <!-- Post list -->
    <main id="view-list" class="view" hidden>
      <header class="bar">
        <div>
          <h1 class="bar-title">글 목록</h1>
          <p id="whoami" class="muted small"></p>
        </div>
        <div class="bar-actions">
          <a href={href("/")} class="btn btn-ghost btn-sm">블로그</a>
          <button type="button" id="logout-btn" class="btn btn-ghost btn-sm">로그아웃</button>
          <button type="button" id="new-btn" class="btn btn-primary btn-sm">새 글</button>
        </div>
      </header>
      <div class="list-tools">
        <input id="filter-input" type="search" placeholder="제목·태그로 찾기" aria-label="글 찾기" />
        <button type="button" id="refresh-btn" class="btn btn-ghost btn-sm">새로고침</button>
      </div>
      <p id="list-status" class="status" role="status" aria-live="polite"></p>
      <ul id="post-list" class="post-list"></ul>
    </main>

    <!-- Editor -->
    <main id="view-editor" class="view editor" hidden>
      <header class="bar">
        <h1 id="editor-heading" class="bar-title">새 글</h1>
        <div class="bar-actions">
          <button type="button" id="back-btn" class="btn btn-ghost btn-sm">목록</button>
        </div>
      </header>

      <form id="editor-form" class="editor-grid" novalidate>
        <div class="editor-main">
          <label class="field">
            <span class="field-label">제목 <span class="counter" data-counter-for="ed-title"></span></span>
            <input id="ed-title" type="text" autocomplete="off" maxlength={POST_LIMITS.title.max} required />
          </label>

          <label class="field" id="slug-field">
            <span class="field-label">주소 (slug)</span>
            <div class="slug-row">
              <span class="muted small" aria-hidden="true">/blog/</span>
              <input id="ed-slug" type="text" autocomplete="off" spellcheck="false" pattern="[a-z0-9가-힣-]+" />
              <span class="muted small" aria-hidden="true">/</span>
            </div>
            <span class="hint">제목에서 자동으로 만들어집니다. 발행 후에는 바꿀 수 없습니다.</span>
          </label>

          <label class="field">
            <span class="field-label">설명 <span class="counter" data-counter-for="ed-desc"></span></span>
            <textarea id="ed-desc" rows="2" maxlength={POST_LIMITS.description.max} required></textarea>
          </label>

          <div class="field-row">
            <label class="field">
              <span class="field-label">태그 (쉼표로 구분, 최대 {POST_LIMITS.tags.max}개)</span>
              <input id="ed-tags" type="text" autocomplete="off" placeholder="구조공학, 수치해석" />
            </label>
            <label class="field">
              <span class="field-label">발행 시각</span>
              <input id="ed-pubdate" type="datetime-local" step="1" />
            </label>
          </div>

          <fieldset class="toggles">
            <legend class="sr-only">글 상태</legend>
            <label class="check"><input id="ed-draft" type="checkbox" /> <span>초안</span></label>
            <label class="check"><input id="ed-verified" type="checkbox" /> <span>사실 확인 완료 (verified)</span></label>
            <label class="check"><input id="ed-featured" type="checkbox" /> <span>추천</span></label>
            <label class="check"><input id="ed-math" type="checkbox" /> <span>수식 (KaTeX)</span></label>
            <label class="check" id="touch-updated-wrap"><input id="ed-touch-updated" type="checkbox" /> <span>저장할 때 수정일 갱신</span></label>
          </fieldset>

          <details class="field-group" id="image-group">
            <summary>대표 이미지 (선택)</summary>
            <div class="field-row">
              <label class="field">
                <span class="field-label">이미지 URL</span>
                <input id="ed-image-url" type="text" autocomplete="off" placeholder="/blog/images/cover.png" />
              </label>
              <label class="field">
                <span class="field-label">대체 텍스트</span>
                <input id="ed-image-alt" type="text" autocomplete="off" />
              </label>
            </div>
          </details>

          <div class="field">
            <div class="field-label">
              <label for="ed-body">본문 (Markdown / MDX)</label>
              <span class="counter" id="body-stats"></span>
            </div>
            <div class="body-tools" role="toolbar" aria-label="본문 도구">
              <button type="button" id="image-btn" class="btn btn-ghost btn-sm">이미지 추가</button>
              <input id="image-input" type="file" accept="image/png,image/jpeg,image/webp,image/avif,image/gif" multiple hidden />
              <span id="pending-images" class="hint" aria-live="polite"></span>
              <span class="hint shortcut-hint">⌘B 굵게 · ⌘I 기울임 · ⌘K 링크 · 이미지는 붙여넣기·끌어놓기도 됩니다</span>
            </div>
            <textarea id="ed-body" class="body-input" spellcheck="false" required></textarea>
          </div>
        </div>

        <aside class="editor-side" aria-labelledby="audit-heading">
          <h2 id="audit-heading" class="side-title">점검</h2>
          <p id="audit-summary" class="muted small"></p>
          <ul id="audit-list" class="audit-list" aria-live="polite"></ul>
          <p class="muted small">
            오류가 있으면 저장되지 않습니다. CI의 <code>npm run audit:blog</code>와 같은 규칙입니다.
          </p>
        </aside>
      </form>

      <footer class="editor-footer">
        <p id="editor-status" class="status" role="status" aria-live="polite"></p>
        <div class="bar-actions">
          <button type="button" id="delete-btn" class="btn btn-danger btn-sm" hidden>삭제</button>
          <button type="button" id="preview-btn" class="btn btn-ghost">미리보기</button>
          <button type="button" id="save-btn" class="btn btn-primary">저장 <kbd>⌘S</kbd></button>
        </div>
      </footer>
    </main>

    <dialog id="preview-dialog" class="preview-dialog" aria-labelledby="preview-heading">
      <div class="preview-bar">
        <h2 id="preview-heading" class="side-title">미리보기 <small class="muted">(수식·MDX 컴포넌트는 원문으로 표시)</small></h2>
        <button type="button" id="preview-close" class="btn btn-ghost btn-sm">닫기</button>
      </div>
      <!-- No allow-scripts, no allow-same-origin: post HTML can't run code or see the token. -->
      <iframe id="preview-frame" title="본문 미리보기" sandbox=""></iframe>
    </dialog>

    <script>
      import "@/admin/main";
    </script>
  </body>
</html>

<style is:global>
  body.admin {
    min-height: 100dvh;
  }

  body.admin::before,
  body.admin::after {
    display: none;
  }

  .admin [hidden] {
    display: none !important;
  }

  .admin .view {
    max-width: 1120px;
    margin: 0 auto;
    padding: calc(2rem + env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right))
      calc(2rem + env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left));
  }

  .admin .muted { color: var(--text-secondary); }
  .admin .small { font-size: 0.8rem; }
  .admin code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
  }

  .admin-noscript { padding: 2rem; text-align: center; }

  /* Buttons */
  .admin .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.05rem;
    font: 500 0.85rem/1.2 var(--font-body);
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, opacity 0.15s;
  }
  .admin .btn:disabled { opacity: 0.5; cursor: progress; }
  .admin .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.78rem; }
  .admin .btn-primary { background: var(--accent); color: var(--bg); }
  .admin .btn-primary:hover:not(:disabled) { background: var(--accent-hover); color: var(--bg); }
  .admin .btn-ghost { background: transparent; color: var(--text-secondary); border-color: var(--border-hover); }
  .admin .btn-ghost:hover { color: var(--text-primary); border-color: var(--text-muted); }
  .admin .btn-danger { background: transparent; color: #f87171; border-color: #4a1d1d; }
  .admin .btn-danger:hover { background: #2a1010; }
  .admin .btn kbd { font: 0.7rem var(--font-mono); opacity: 0.7; }

  /* Forms */
  .admin .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.1rem; min-width: 0; }
  .admin .field-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }
  .admin .counter { font-family: var(--font-mono); font-weight: 400; color: var(--text-muted); }
  .admin .counter.over { color: #f87171; }
  .admin .hint { font-size: 0.72rem; color: var(--text-muted); }
  .admin input[type="text"],
  .admin input[type="password"],
  .admin input[type="search"],
  .admin input[type="datetime-local"],
  .admin textarea {
    width: 100%;
    padding: 0.6rem 0.85rem;
    font: 0.92rem/1.6 var(--font-body);
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-hover);
    border-radius: 8px;
    color-scheme: dark;
  }
  .admin input:focus,
  .admin textarea:focus { outline: none; border-color: var(--accent); }
  .admin input[aria-invalid="true"] { border-color: #f87171; }
  .admin textarea { resize: vertical; }
  .admin .body-tools { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.9rem; }
  .admin .shortcut-hint { margin-left: auto; }
  .admin .body-input.dragging { border-color: var(--accent); border-style: dashed; }
  .admin .body-input {
    min-height: 55vh;
    font: 0.86rem/1.75 var(--font-mono);
    tab-size: 2;
  }
  .admin .field-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0 1rem; }
  .admin .slug-row { display: flex; align-items: center; gap: 0.35rem; }
  .admin .check { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer; }
  .admin .check input { width: 16px; height: 16px; accent-color: var(--accent); }
  .admin .toggles { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; margin: 0 0 1.1rem; padding: 0; border: 0; }
  .admin .field-group { margin-bottom: 1.1rem; }
  .admin .field-group > summary { cursor: pointer; font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.75rem; }

  .admin .status { min-height: 1.4em; font-size: 0.82rem; color: var(--text-secondary); }
  .admin .status[data-tone="error"] { color: #f87171; }
  .admin .status[data-tone="success"] { color: #4ade80; }

  /* Login */
  .admin .login { max-width: 460px; padding-top: 14vh; }
  .admin .login-title { font: 700 1.8rem/1.3 var(--font-heading); margin-bottom: 0.6rem; }
  .admin .login-form { display: flex; flex-direction: column; gap: 0.9rem; margin: 1.75rem 0; }
  .admin .login-form .btn { align-self: flex-start; }
  .admin .help { font-size: 0.85rem; line-height: 1.7; color: var(--text-secondary); }
  .admin .help summary { cursor: pointer; color: var(--text-primary); }
  .admin .help ol { margin: 0.75rem 0; padding-left: 1.25rem; list-style: decimal; }

  /* Bars */
  .admin .bar { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; flex-wrap: wrap; }
  .admin .bar-title { font: 700 1.5rem/1.3 var(--font-heading); }
  .admin .bar-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

  /* List */
  .admin .list-tools { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
  .admin .post-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .admin .post-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-hover);
    border-radius: 10px;
  }
  .admin .post-row:hover { background: var(--bg-surface); }
  .admin .post-open {
    flex: 1;
    min-width: 0;
    text-align: left;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
  }
  .admin .post-name { font: 700 1rem/1.4 var(--font-heading); color: var(--text-primary); }
  .admin .post-meta { margin-top: 0.25rem; font: 0.72rem var(--font-mono); color: var(--text-muted); display: flex; flex-wrap: wrap; gap: 0.35rem 0.75rem; }
  .admin .badge { display: inline-block; padding: 0.05rem 0.45rem; border-radius: 999px; font: 600 0.65rem var(--font-body); border: 1px solid; }
  .admin .badge-draft { color: #fca5a5; border-color: rgba(248, 113, 113, 0.35); }
  .admin .badge-live { color: #86efac; border-color: rgba(74, 222, 128, 0.35); }
  .admin .badge-warn { color: var(--accent); border-color: rgba(232, 168, 73, 0.4); }
  .admin .badge-error { color: #f87171; border-color: rgba(248, 113, 113, 0.5); }
  .admin .empty { padding: 3rem 0; text-align: center; color: var(--text-muted); }

  /* Editor */
  .admin .editor-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 2rem; align-items: start; }
  .admin .editor-side {
    position: sticky;
    top: 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border-hover);
    border-radius: 10px;
    background: var(--bg-surface);
    max-height: calc(100dvh - 3rem);
    overflow: auto;
  }
  .admin .side-title { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 0.35rem; }
  .admin .audit-list { list-style: none; margin: 0.75rem 0; padding: 0; display: grid; gap: 0.5rem; font-size: 0.8rem; line-height: 1.5; }
  .admin .audit-list li { padding-left: 0.75rem; border-left: 2px solid var(--border-hover); }
  .admin .audit-list li[data-severity="error"] { border-color: #f87171; color: #fecaca; }
  .admin .audit-list li[data-severity="warning"] { border-color: var(--accent); color: var(--text-secondary); }
  .admin .audit-list .line { font-family: var(--font-mono); color: var(--text-muted); margin-right: 0.35rem; }
  .admin .editor-footer {
    position: sticky;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 0 calc(1rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border-hover);
    background: var(--bg);
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .admin .editor-grid { grid-template-columns: minmax(0, 1fr); }
    .admin .editor-side { position: static; max-height: none; }
  }

  /* Preview */
  .admin .preview-dialog {
    width: min(860px, 94vw);
    height: min(90dvh, 1100px);
    padding: 0;
    border: 1px solid var(--border-hover);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text-primary);
  }
  .admin .preview-dialog::backdrop { background: rgba(0, 0, 0, 0.7); }
  .admin .preview-dialog[open] { display: flex; flex-direction: column; }
  .admin .preview-bar { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-hover); }
  .admin .preview-dialog iframe { flex: 1; width: 100%; border: 0; background: var(--bg); }
</style>
