---
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PostNav from "@/components/PostNav.astro";
import PostComments from "@/components/PostComments.astro";
import ReadingTime from "@/components/ReadingTime.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Callout from "@/components/mdx/Callout.astro";
import Figure from "@/components/mdx/Figure.astro";
import { getAllPosts, relatedPosts, type BlogPost } from "@/utils/posts";
import { getPostSocialImage, getPostSocialImageAlt } from "@/utils/social-image";
import { formatDateLong } from "@/lib/dates";
import { getReadingMinutes } from "@/lib/reading-time";
import { hasMathSyntax } from "@/lib/post-rules";
import { FOOTNOTE_LABEL_ID } from "@/lib/markdown/rehype-prose";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, math, draft } = post.data;
const body = post.body ?? "";

const { Content, headings } = await render(post);
const socialImage = getPostSocialImage(post);
const socialImageAlt = getPostSocialImageAlt(post);

const allPosts = await getAllPosts();
const idx = allPosts.findIndex((p) => p.id === post.id);
const prevPost = idx >= 0 && idx < allPosts.length - 1 ? (allPosts[idx + 1] ?? null) : null;
const nextPost = idx > 0 ? (allPosts[idx - 1] ?? null) : null;
const related = relatedPosts(post, allPosts).filter(
  (p) => p.id !== prevPost?.id && p.id !== nextPost?.id,
);

const tocHeadings = headings.filter(
  (h) => h.depth >= 2 && h.depth <= 3 && h.slug !== FOOTNOTE_LABEL_ID,
);
// Load KaTeX styles whenever the body actually contains math, even if the
// author forgot `math: true`; otherwise formulas render as raw glyph soup.
const needsMath = math || hasMathSyntax(body);
const readingMinutes = getReadingMinutes(body);
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  imageAlt={socialImageAlt}
  math={needsMath}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
  readingMinutes={readingMinutes}
  noIndex={draft}
>
  <article class="post-layout" aria-labelledby="post-article-title">
    <header class="mb-12 max-w-[720px]">
      {draft && <p class="draft-banner" role="note">초안 미리보기: 프로덕션 빌드에는 포함되지 않습니다.</p>}
      {tags.length > 0 && (
        <ul class="mb-4 flex flex-wrap gap-2" aria-label="태그">
          {tags.map((tag) => (
            <li class="tag-chip">{tag}</li>
          ))}
        </ul>
      )}

      <h1
        id="post-article-title"
        class="heading-page text-3xl leading-tight tracking-tight sm:text-4xl lg:text-5xl"
        transition:name={`post-title-${post.id}`}
      >
        {title}
      </h1>

      <p class="sr-only">{description}</p>

      <div class="text-muted-sm mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
        <time datetime={pubDate.toISOString()}>{formatDateLong(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              수정 <time datetime={updatedDate.toISOString()}>{formatDateLong(updatedDate)}</time>
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <ReadingTime content={body} />
      </div>
    </header>

    <div class="flex gap-12">
      <div class="min-w-0 max-w-[720px] flex-1">
        {tocHeadings.length > 1 && (
          <TableOfContents headings={tocHeadings} variant="inline" />
        )}

        <div class="prose">
          <Content components={{ Callout, Figure }} />
        </div>

        <RelatedPosts posts={related} />
        <PostNav prev={prevPost} next={nextPost} />
        {!draft && (
          <PostComments
            identifier={post.id}
            url={new URL(Astro.url.pathname, Astro.site).toString()}
            title={title}
          />
        )}
      </div>

      {tocHeadings.length > 1 && (
        <div class="hidden w-56 shrink-0 lg:block">
          <TableOfContents headings={tocHeadings} variant="sidebar" />
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .tag-chip {
    display: inline-block;
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .draft-banner {
    margin-bottom: 1.25rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.8rem;
    color: #fca5a5;
    border: 1px dashed rgba(248, 113, 113, 0.4);
    border-radius: 0.5rem;
  }
</style>

<script>
  // Clicking a section's "#" permalink still jumps to it, and also copies
  // the full URL so it can be pasted straight into a message or a paper.
  // Registered once: module scripts survive ClientRouter navigations.
  function toast(message: string) {
    let el = document.getElementById("copy-toast");
    if (!el) {
      el = document.createElement("div");
      el.id = "copy-toast";
      el.className = "copy-toast";
      el.setAttribute("role", "status");
      document.body.append(el);
    }
    el.textContent = message;
    el.classList.add("show");
    window.clearTimeout(Number(el.dataset["timer"]));
    el.dataset["timer"] = String(window.setTimeout(() => el?.classList.remove("show"), 1800));
  }

  document.addEventListener("click", (event) => {
    const anchor = (event.target as Element | null)?.closest<HTMLAnchorElement>(".prose .heading-anchor");
    if (!anchor || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    const url = new URL(anchor.getAttribute("href") ?? "", location.href).href;
    navigator.clipboard?.writeText(url).then(
      () => toast("섹션 링크를 복사했습니다"),
      () => {
        /* clipboard blocked: the jump still happens */
      },
    );
  });
</script>
